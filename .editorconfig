# Indica que este es el archivo de configuración raíz
root = true

# Configuración para todos los archivos del proyecto
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Configuración específica para Kotlin
[*.{kt,kts}]
# Estilo de código oficial de ktlint
ktlint_code_style = ktlint_official

# Tamaño de sangría (4 espacios es el estándar)
indent_size = 4

# Longitud máxima de línea recomendada
max_line_length = 120

# Reglas estrictas de calidad y estilo
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled
ktlint_standard_modifier-order = enabled

# Flexibilidad acordada: nombres de archivos Kotlin no obligados a coincidir con una única clase
ktlint_standard_filename = disabled

# Permitir guión bajo inicial en estado mutable privado (ej. _line, _col, _offset)
ktlint_standard_backing-property-naming = disabled

# Permitir paquetes de versión con guión bajo (ej. v1_0, v1_1)
ktlint_standard_package-name = disabled

# Excepción para tests con nombres descriptivos en backticks
[**/test/**.kt]
ktlint_standard_function-naming = disabled

